{
  "name": "miyami-websearch-mcp",
  "version": "1.2.0",
  "description": "MCP server providing web search and content extraction for LLMs",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "miyami-websearch-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"Tests coming soon\" && exit 0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "search",
    "web-search",
    "claude",
    "anthropic",
    "searxng",
    "internet-access",
    "web-scraping",
    "content-extraction"
  ],
  "author": "Ankush Thakur <ankushthakur2007@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankushthakur2007/miyami-websearch-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ankushthakur2007/miyami-websearch-mcp/issues"
  },
  "homepage": "https://github.com/ankushthakur2007/miyami-websearch-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "preferGlobal": false
}